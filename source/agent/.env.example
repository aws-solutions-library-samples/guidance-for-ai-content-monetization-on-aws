# Analytics Agent Configuration
# Copy this file to .env and configure your preferred LLM provider

# === Local LLM Configuration (Ollama) ===
# Set to 'true' to use local Ollama models
USE_LOCAL_LLM=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === OpenAI Configuration ===
# Uncomment and set your OpenAI API key to use OpenAI models
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# === Anthropic Configuration ===
# Uncomment and set your Anthropic API key to use Claude models
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# === AWS Bedrock Configuration (Default) ===
# AWS credentials should be configured via AWS CLI or environment variables
AWS_DEFAULT_REGION=us-west-2
BEDROCK_MODEL=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# === IAB API Configuration ===
IAB_API_BASE_URL=https://api.iab-framework.example.com
PUBLISHER_API_KEY=your_publisher_api_key_here

# === Mock Data Integration Configuration ===
# Set to 'true' to use mock analytics tools instead of real MCP client
USE_MOCK_ANALYTICS=false
# Set to 'true' to enable full demo mode with all mock features
DEMO_MODE=false

# === AgentCore Gateway Configuration (Optional) ===
AGENTCORE_GATEWAY_URL=https://your-agentcore-gateway.com