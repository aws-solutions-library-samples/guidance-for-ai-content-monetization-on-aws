{
  "name": "ai-content-monetization-demo-ui",
  "version": "1.0.0",
  "description": "Demo UI for AI Content Monetization Framework",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:demo": "NODE_OPTIONS=--max-old-space-size=4096 vite build --mode demo",
    "build:production": "NODE_OPTIONS=--max-old-space-size=4096 vite build --mode production",
    "build:with-types": "tsc && NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "preview:production": "vite preview --mode production",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.0.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.883.0",
    "@cloudscape-design/components": "^3.0.0",
    "@cloudscape-design/design-tokens": "^3.0.0",
    "@cloudscape-design/global-styles": "^1.0.0",
    "@scalar/api-reference-react": "^0.9.65",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.4",
    "aws-amplify": "^6.0.0",
    "axios": "^1.6.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "date-fns": "^2.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^23.2.0",
    "typescript": "^5.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
