# Publisher Content Monetization for AI Agents - UI Environment Configuration

# Solution display name shown in the UI chrome.
# `make build-ui` derives this from solution-manifest.yaml `name` (strips the
# "Guidance for " prefix and " on AWS" suffix). Set it here only to override;
# if unset, the UI falls back to the built-in name in src/config/solutionName.ts.
# VITE_SOLUTION_NAME=Publisher Content Monetization for AI Agents

# Demo Mode Configuration
# Set to 'true' to enable demo features (Demo Controller, AI Agent Simulator, etc.)
# Set to 'false' for production deployments
VITE_ENABLE_DEMO=false

# API Configuration
VITE_API_BASE_URL=https://your-api-gateway-url.amazonaws.com
VITE_API_VERSION=v1

# AWS Configuration
VITE_AWS_REGION=us-west-2

# Cognito Authentication Configuration
VITE_USER_POOL_ID=your-user-pool-id
VITE_USER_POOL_CLIENT_ID=your-user-pool-client-id
VITE_IDENTITY_POOL_ID=your-identity-pool-id
VITE_COGNITO_DOMAIN=your-cognito-domain.auth.us-west-2.amazoncognito.com

# Analytics Configuration
VITE_ENABLE_ANALYTICS=true
VITE_ANALYTICS_ENDPOINT=/api/analytics

# AgentCore Observability Configuration
# These are used to generate deep links to CloudWatch GenAI Observability
VITE_ANALYTICS_AGENT_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:agent/analytics-agent-id/runtime/runtime-id
VITE_MCP_SERVER_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:agent/mcp-server-id/runtime/runtime-id
VITE_CLOUDWATCH_GENAI_URL=https://us-west-2.console.aws.amazon.com/cloudwatch/home?region=us-west-2#/gen-ai-observability/agent-core/agents

# Mock Data Integration Configuration
# Set to 'true' to use mock data instead of real IAB API calls
VITE_USE_MOCK_DATA=false
# Set to 'true' to use mock analytics tools instead of real MCP client
VITE_USE_MOCK_ANALYTICS=false
# Set to 'true' to enable full demo mode with all mock features
VITE_DEMO_MODE=false

# Feature Flags (Advanced Configuration)
# These can be used to enable/disable specific features independently
# If not set, they default to the value of VITE_ENABLE_DEMO
# VITE_ENABLE_DEMO_CONTROLLER=false
# VITE_ENABLE_DEMO_SCENARIOS=false
# VITE_ENABLE_MOCK_DATA=false

# WordPress Integration Configuration
# NOTE: Both WordPress build flags were retired. VITE_ENABLE_WORDPRESS_INTEGRATION
# was retired by the WordPress re-home, and VITE_ENABLE_WORDPRESS_MOCK_UI was retired
# alongside it (it was tied to the deprecated WordPressConnector). WordPress is now
# surfaced as a content-domain Connection driven by connection-activation state, not a
# build-time flag.

# MediaLake Integration Configuration
# These are automatically detected if MediaLake is deployed
VITE_MEDIALAKE_STACK_NAME=your-medialake-stack-name
VITE_MEDIALAKE_REGION=us-west-2
VITE_MEDIALAKE_USER_POOL_ID=your-medialake-user-pool-id
VITE_MEDIALAKE_USER_POOL_CLIENT_ID=your-medialake-user-pool-client-id
VITE_MEDIALAKE_IDENTITY_POOL_ID=your-medialake-identity-pool-id
VITE_MEDIALAKE_UI_URL=https://your-medialake-ui-url.amazonaws.com